<Window x:Class="VictoryLauncher.ControlsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controls" Width="540" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FF1B0A2A"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True">
    <DockPanel Margin="24,18,24,20">
        <TextBlock DockPanel.Dock="Top" Text="Keyboard controls" FontFamily="{StaticResource Display}"
                   FontWeight="SemiBold" FontSize="19" />
        <TextBlock DockPanel.Dock="Top" x:Name="ForkText" Foreground="{StaticResource Teal}" TextWrapping="Wrap"
                   Margin="0,4,0,12" />

        <Button DockPanel.Dock="Bottom" x:Name="CloseButton" Content="CLOSE" Width="110" HorizontalAlignment="Right"
                Margin="0,14,0,0" IsCancel="True" IsDefault="True" />
        <ItemsControl DockPanel.Dock="Bottom" x:Name="NoteList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource Note}" Margin="1,0,0,5" Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border CornerRadius="10" Background="#73000000" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="14,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="KeyList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Pad}" Foreground="{StaticResource InkSoft}" />
                                <TextBlock Grid.Column="1" Text="{Binding Keys}" FontFamily="{StaticResource Display}"
                                           FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
