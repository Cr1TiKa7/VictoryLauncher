<Window x:Class="VictoryLauncher.ProgramDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Before the start" Width="660" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FF1B0A2A"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True">
    <DockPanel Margin="24,18,24,20">
        <TextBlock DockPanel.Dock="Top" Text="These programs are using performance" FontFamily="{StaticResource Display}"
                   FontWeight="SemiBold" FontSize="19" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource InkSoft}" Margin="0,6,0,14"
                   Text="Ticked programs are first closed normally, like a click on the X. If one keeps running, the launcher asks again before it force closes it." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseSelectedButton" Content="CLOSE SELECTED AND START" IsEnabled="False"
                    Click="CloseSelected_Click" />
            <Button x:Name="StartButton" Content="START ANYWAY" Margin="10,0,0,0" Click="Start_Click" />
            <Button x:Name="AbortButton" Content="CANCEL" Margin="10,0,0,0" IsCancel="True" />
        </StackPanel>

        <Border CornerRadius="10" Background="#73000000" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProgramList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="ProgramBox" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}"
                                      Checked="Program_Toggled" Unchecked="Program_Toggled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Margin="16,0,0,0"
                                               Foreground="{StaticResource Amber}" />
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
