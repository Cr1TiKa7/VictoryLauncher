<!-- Own vector art: sunset sky, striped sun, skyline, sea and palms. -->
<UserControl x:Class="VictoryLauncher.SunsetHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="210" ClipToBounds="True">
    <UserControl.Resources>
        <DrawingImage x:Key="Palm">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- keeps the drawing's box fixed at 200 x 240 -->
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H200 V240 H0 Z" />
                    <!-- trunk -->
                    <GeometryDrawing Brush="#FF14051F"
                                     Geometry="M82,240 C92,180 96,130 112,78 L121,81 C109,132 106,182 100,240 Z" />
                    <!-- fronds -->
                    <GeometryDrawing Brush="#FF14051F"
                                     Geometry="M116,78 C92,48 52,44 14,70 C34,66 40,70 42,74 C54,66 62,70 64,76 C76,70 84,74 86,80 C96,76 106,76 116,82 Z" />
                    <GeometryDrawing Brush="#FF14051F"
                                     Geometry="M115,80 C84,76 56,94 42,132 C56,116 64,116 68,118 C72,106 82,104 86,106 C90,96 100,94 104,95 C107,90 111,86 119,84 Z" />
                    <GeometryDrawing Brush="#FF14051F"
                                     Geometry="M114,77 C108,44 84,22 46,18 C64,28 66,34 66,38 C78,36 84,44 84,50 C94,50 98,58 98,64 C104,68 108,73 112,82 Z" />
                    <GeometryDrawing Brush="#FF14051F"
                                     Geometry="M115,78 C122,44 148,24 188,24 C168,32 164,38 164,42 C152,40 146,48 146,54 C136,54 132,62 132,68 C126,71 122,76 118,83 Z" />
                    <GeometryDrawing Brush="#FF14051F"
                                     Geometry="M117,79 C144,56 176,58 198,88 C182,80 174,82 172,86 C162,78 154,82 152,86 C142,80 134,84 132,88 C127,86 122,85 115,85 Z" />
                    <GeometryDrawing Brush="#FF14051F"
                                     Geometry="M117,81 C142,82 164,102 170,138 C159,122 152,121 148,122 C146,111 138,108 134,109 C132,100 124,96 120,96 C118,92 115,89 113,85 Z" />
                    <GeometryDrawing Brush="#FF14051F" Geometry="M108,80 A7,7 0 1 0 122,80 A7,7 0 1 0 108,80 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1B0A2E" Offset="0" />
                    <GradientStop Color="#FF4A1466" Offset="0.30" />
                    <GradientStop Color="#FFB4277E" Offset="0.58" />
                    <GradientStop Color="#FFFF6A6A" Offset="0.78" />
                    <GradientStop Color="#FFFFB36B" Offset="0.86" />
                    <GradientStop Color="#FF2A0F45" Offset="0.861" />
                    <GradientStop Color="#FF1B0A2A" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- sun, cut by the stripes of the evening haze; its lower end sits on the horizon -->
        <Canvas Width="190" Height="152" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,29,190,0">
            <Path>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFE29A" Offset="0" />
                        <GradientStop Color="#FFFF9E5E" Offset="0.5" />
                        <GradientStop Color="#FFFF3D9A" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <CombinedGeometry GeometryCombineMode="Intersect">
                                <CombinedGeometry.Geometry1>
                                    <EllipseGeometry Center="95,95" RadiusX="95" RadiusY="95" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry Rect="0,0,190,152" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <PathGeometry Figures="M0,86 H190 V89 H0 Z M0,101 H190 V105 H0 Z M0,116 H190 V122 H0 Z M0,132 H190 V140 H0 Z" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- skyline on the horizon -->
        <Viewbox Stretch="Fill" Height="62" VerticalAlignment="Top" Margin="0,119,0,0">
            <Canvas Width="940" Height="62">
                <Path Fill="#FF2C0E48"
                      Data="M0,62 V44 H26 V30 H44 V44 H62 V20 H70 V12 H74 V20 H86 V46 H112 V36 H140 V50 H176 V24 H198 V16 H206 V24 H214 V52 H252 V40 H272 V28 H292 V54 H340 V46 H372 V34 H390 V46 H414 V56 H470 V48 H498 V38 H520 V56 H590 V50 H640 V42 H662 V54 H712 V32 H732 V22 H746 V32 H760 V52 H792 V40 H820 V18 H826 V8 H830 V18 H838 V46 H866 V34 H892 V50 H914 V28 H940 V62 Z" />
                <Path Fill="#B3FFD36B"
                      Data="M32,36 h3 v3 h-3 Z M68,28 h3 v3 h-3 Z M76,38 h3 v3 h-3 Z M182,32 h3 v3 h-3 Z M192,42 h3 v3 h-3 Z M278,36 h3 v3 h-3 Z M378,42 h3 v3 h-3 Z M508,46 h3 v3 h-3 Z M720,40 h3 v3 h-3 Z M740,30 h3 v3 h-3 Z M750,44 h3 v3 h-3 Z M824,28 h3 v3 h-3 Z M832,38 h3 v3 h-3 Z M876,42 h3 v3 h-3 Z M924,38 h3 v3 h-3 Z" />
            </Canvas>
        </Viewbox>

        <!-- reflections on the water -->
        <Canvas Width="190" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,183,190,0">
            <Rectangle Canvas.Left="22" Canvas.Top="2" Width="146" Height="2" Fill="#B3FF9E5E" />
            <Rectangle Canvas.Left="44" Canvas.Top="9" Width="102" Height="2" Fill="#8CFF6A8A" />
            <Rectangle Canvas.Left="62" Canvas.Top="16" Width="66" Height="2" Fill="#66FF3D9A" />
            <Rectangle Canvas.Left="80" Canvas.Top="23" Width="30" Height="2" Fill="#40FF3D9A" />
        </Canvas>

        <!-- palms -->
        <Image Source="{StaticResource Palm}" Width="172" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,6,0" />
        <Image Source="{StaticResource Palm}" Width="118" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,128,0" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="-1" />
            </Image.RenderTransform>
        </Image>

        <!-- wordmark -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,24,0,0">
            <TextBlock Text="VI" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="104" LineHeight="96"
                       LineStackingStrategy="BlockLineHeight">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFF1C9" Offset="0" />
                        <GradientStop Color="#FFFFA14A" Offset="0.35" />
                        <GradientStop Color="#FFFF2E88" Offset="0.75" />
                        <GradientStop Color="#FF8A3FFC" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF2E88" ShadowDepth="0" BlurRadius="28" Opacity="0.85" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="V I C T O R Y   L A U N C H E R" FontFamily="Bahnschrift" FontWeight="SemiBold"
                       FontSize="13" Foreground="#FFFFFFFF" Margin="4,2,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#14051F" ShadowDepth="1" BlurRadius="4" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
