<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VictoryLauncher.Core\VictoryLauncher.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- the "VI" of the header; windows without an own icon show it too -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 0.0.0 marks a build nobody released; it never updates itself. The release action sets the real number. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

</Project>
