<Window x:Class="VictoryLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VictoryLauncher"
        Title="VictoryLauncher" Width="940" Height="900" MinWidth="760" MinHeight="720"
        WindowStartupLocation="CenterScreen" Foreground="{StaticResource Ink}" UseLayoutRounding="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1B0A2A" Offset="0.2" />
            <GradientStop Color="#FF10051B" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <DockPanel>
        <local:SunsetHeader DockPanel.Dock="Top" />

        <DockPanel Margin="24,6,24,20">
            <Border DockPanel.Dock="Top" x:Name="UpdateBar" Visibility="Collapsed" CornerRadius="7" Background="#1EFFC857"
                    BorderBrush="#66FFC857" BorderThickness="1" Padding="12,5" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="UpdateButton" Content="UPDATE" Width="130" Padding="4,4"
                            Margin="12,0,0,0" Click="Update_Click" />
                    <TextBlock x:Name="UpdateText" Foreground="{StaticResource Amber}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="FORK" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ForkBox" SelectionChanged="Fork_Changed" Margin="0,0,0,8" />
                <Button Grid.Row="0" Grid.Column="2" x:Name="RemoveForkButton" Content="REMOVE" Width="96" Padding="4,4"
                        Margin="8,0,0,8" Visibility="Hidden" Click="RemoveFork_Click" />

                <TextBlock Grid.Row="1" x:Name="UrlLabel" Style="{StaticResource Label}" Text="GIT-URL" Visibility="Collapsed" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="UrlBox" Style="{StaticResource PathBox}" Visibility="Collapsed"
                         KeyDown="Url_KeyDown" />
                <Button Grid.Row="1" Grid.Column="2" x:Name="AddUrlButton" Content="ADD" Width="96" Padding="4,4"
                        Margin="8,0,0,8" Visibility="Collapsed" Click="AddUrl_Click" />

                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ForkNote" Style="{StaticResource Note}" />

                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="VERSION" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VersionText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Teal}" Margin="1,0,0,8" />
                <Button Grid.Row="3" Grid.Column="2" x:Name="CheckButton" Content="CHECK" Width="96" Padding="4,4"
                        Margin="8,0,0,8" Click="Check_Click" />

                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="GAME FOLDER" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="GameBox" Style="{StaticResource PathBox}" TextChanged="Paths_Changed" />
                <Button Grid.Row="4" Grid.Column="2" x:Name="GameBrowse" Content="…" Width="96" Margin="8,0,0,8" Click="BrowseGame_Click" />

                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="CACHE FOLDER" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="CacheBox" Style="{StaticResource PathBox}" TextChanged="Paths_Changed" />
                <Button Grid.Row="5" Grid.Column="2" x:Name="CacheBrowse" Content="…" Width="96" Margin="8,0,0,8" Click="BrowseCache_Click" />

                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="CHECKOUT FOLDER" />
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="RepoBox" Style="{StaticResource PathBox}" TextChanged="Paths_Changed" />
                <Button Grid.Row="6" Grid.Column="2" x:Name="RepoBrowse" Content="…" Width="96" Margin="8,0,0,8" Click="BrowseRepo_Click" />
            </Grid>

            <TextBlock DockPanel.Dock="Top" x:Name="HintText" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,2,0,10" />

            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Left" x:Name="WarmButton" Content="WARMUP" Width="130" MinHeight="34" Click="Warm_Click" />
                <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="CANCEL" Width="110" Margin="10,0,0,0" IsEnabled="False" Click="Cancel_Click" />
                <ProgressBar x:Name="WarmBar" Height="16" Margin="12,0,0,0" Minimum="0" Maximum="100" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,14" Text="Ready." />

            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" x:Name="ControlsButton" Content="CONTROLS" Width="130" Height="54"
                        Margin="12,0,0,0" Click="Controls_Click" />
                <!-- in this row so that the choice costs no height: the smallest window has none to spare -->
                <ComboBox DockPanel.Dock="Right" x:Name="ConsoleBox" Width="180" Height="54" Margin="12,0,0,0"
                          SelectionChanged="Console_Changed">
                    <ComboBoxItem Content="Series X (default)" />
                    <ComboBoxItem Content="Series S" />
                </ComboBox>
                <!-- only there for a fork that offers it; the window code fills the list -->
                <ComboBox DockPanel.Dock="Right" x:Name="OutputBox" Width="170" Height="54" Margin="12,0,0,0"
                          Visibility="Collapsed" ToolTipService.ShowOnDisabled="True" SelectionChanged="Output_Changed" />
                <Button x:Name="PlayButton" Content="START GAME" Style="{StaticResource PlayButtonStyle}" Click="Play_Click" />
            </DockPanel>

            <!-- below the start button: it takes its room from the log and never moves the button -->
            <TextBlock DockPanel.Dock="Top" x:Name="ConsoleNote" Style="{StaticResource Note}" Margin="1,8,0,0"
                       Foreground="{StaticResource Amber}" Visibility="Collapsed" />

            <TextBox x:Name="LogBox" Margin="0,16,0,0" Style="{StaticResource LogStyle}" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </DockPanel>
    </DockPanel>
</Window>
